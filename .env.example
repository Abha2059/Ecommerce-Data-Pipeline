# =====================================================================
# Historical E-Commerce Data Engineering Pipeline Environment
# =====================================================================

# Database Configuration (MySQL 8.0+)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_dw
MYSQL_USER=root
MYSQL_PASSWORD=

# Docker Compose Database Settings
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_CONTAINER_HOST_PORT=3307

# Verified Historical Data Source (UCI Machine Learning Repository)
HISTORICAL_SOURCE_URL=https://archive.ics.uci.edu/static/public/352/online+retail.zip

# Airflow Settings
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_PIP_ADDITIONAL_REQUIREMENTS=

# PySpark Environment
SPARK_MASTER=local[*]
JAVA_HOME=

# AWS S3 Data Lake & Streamlit Cloud Settings (Optional for Cloud Deployment)
DATA_SOURCE=auto
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ecommerce-data-pipeline-abhay-699258776334
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

